import csv

data = [
    ['Adyar', '2026-10-01', 48],
    ['Guindy', '2026-10-01', 95],
    ['Adyar', '2026-10-02', 60]
]

with open('air.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['Station', 'Date', 'PM25'])
    w.writerows(data)

with open('air.csv', 'r') as f:
    for row in csv.reader(f):
        print(row)
